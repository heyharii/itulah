{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Central Gudang",
  "identifier": "id.itulah.gudang.desktop",
  "build": {
    "frontendDist": "../ui/dist-gudang",
    "devUrl": "http://localhost:5416",
    "beforeDevCommand": {
      "script": "npm run dev:gudang",
      "cwd": "../ui"
    },
    "beforeBuildCommand": {
      "script": "npm run build:gudang",
      "cwd": "../ui"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Central Gudang",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "windows": {
      "wix": {
        "fragmentPaths": [
          "wix/uninstall-guard-gudang.wxs"
        ],
        "componentGroupRefs": [
          "CentralGudangUninstallGuard"
        ]
      }
    }
  },
  "mainBinaryName": "central-gudang"
}
