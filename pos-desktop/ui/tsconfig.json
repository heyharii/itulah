{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["./src/*"],
      "@epc": ["../../frontend-store-new/src/lib/epc.ts"],
      "@itulah/contract": ["../../frontend-contract/src/index.ts"],
      "@itulah/contract/money": ["../../frontend-contract/src/money/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
