.git
.gitignore
.env
.env.*
**/*.sqlite3
**/*.sqlite3-shm
**/*.sqlite3-wal
backend/target
docs/*.png
semantic-review

# Patterns, not paths. These used to name frontend/ and frontend-new/ one by
# one, so when the surfaces were renamed the entries silently stopped matching
# anything and three node_modules trees — about 440 packages each — started
# riding along in the build context. A glob cannot go stale that way.
**/node_modules
**/dist
**/.vite
**/.tanstack
**/.env.local*
