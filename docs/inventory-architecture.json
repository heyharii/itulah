  "cards": [
    {
      "dot": "cyan",
      "title": "Orthogonal meanings",
      "items": [
        "POOL = where inventory currently is",
        "ALLOTMENT = intended destination Store",
        "MOVEMENT = inventory actually changes placement"
      ]
    },
    {
      "dot": "emerald",
      "title": "Commitment math",
      "items": [
        "Available = DC Warehouse On Hand - active remaining Allotment",
        "Create and cancel append Allotment events and create zero movement",
        "Missing and Reject never satisfy a new Allotment"
      ]
    },
    {
      "dot": "amber",
      "title": "Physical transition",
      "items": [
        "Pick atomically moves Warehouse → Picked and reduces remaining commitment",
        "Allotment ID and destination Store remain movement provenance",
        "Count shortage surfaces ALLOTMENT_SHORTAGE without rewriting commitments"
      ]
    }
  ]
