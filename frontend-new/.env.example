# Local proxy targets. These values are read by vite.config.ts; browser
# requests stay same-origin so the proxy can forward cookies and local auth.
VITE_CLOUD_HUB_URL=http://localhost:8080
VITE_DC_EDGE_URL=http://localhost:8090
VITE_STORE_ROUTER_URL=http://localhost:8081

# Optional local-only credentials. Leave these blank to send no auth headers;
# protected routes should then fail at the backend instead of using a shared
# fallback identity. Keep credentials unprefixed: VITE_* variables are exposed
# to browser modules by Vite. Never commit real values or use these as a
# production authentication mechanism.
CLOUD_HUB_API_KEY=
CLOUD_HUB_USER_ID=
CLOUD_HUB_USER_ROLE=
CLOUD_HUB_ACTOR_ID=
EDGE_API_KEY=
STORE_API_KEY=

# Existing VITE_* credential names remain accepted for local compatibility, but
# unprefixed names above are preferred so secrets cannot be bundled by mistake.
# Optional direct browser API origins for deployments without a same-origin
# proxy. Do not use the *_HUB_URL/*_ROUTER_URL/*_EDGE_URL proxy targets here.
# VITE_CLOUD_API_URL=https://cloud.example.com
# VITE_STORE_API_URL=https://store.example.com
# VITE_EDGE_API_URL=https://dc.example.com
# Optional override; defaults to Internal's relational compatibility route.
VITE_SOURCING_SHORTLIST_PATH=/v1/sourcing-shortlist
# Optional destination override; the UI validates it against active masterdata
# locations and otherwise selects the first active DC.
VITE_PO_DELIVERY_TO=dc-001
