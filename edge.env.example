# ── Edge node (DC / Store, SQLite) ───────────────────────────────────────────
# The local-development shape of a node's variables. Deployed shops use
# deploy/edge/store.env.example and DCs deploy/edge/dc.env.example; the cloud
# counterpart is cloud.env.example.

# Identity. INVENTORY_NODE_ID is also the sync origin: the cloud knows this
# node's facts by this name, so it must be unique and must not change. The
# node refuses to boot against a database that was enrolled for another
# (role, site, node) triple.
INVENTORY_NODE_ID=store-07
INVENTORY_NODE_ROLE=STORE                # or DC
INVENTORY_SITE_ID=store-07
INVENTORY_ORIGIN_GENERATION=1            # advance only after Cloud activated
                                         # the rollover and the previous
                                         # generation's backlog is fully
                                         # acknowledged
INVENTORY_DATABASE_PATH=./store-edge.sqlite3
BIND_ADDR=127.0.0.1:8082                 # a DC with LAN readers/printers binds
                                         # its LAN address instead

# ── Ordered upload to the cloud ──────────────────────────────────────────────
# SYNC_UPLOAD_URL is the cloud's base URL — do not append /api/v1/sync/ingest;
# the sender adds that path. Unset = sender off: every fact stays in the local
# SQLite outbox and uploads when the URL appears. When the URL is set, a
# nonempty SYNC_UPLOAD_KEY is required; it authorises the origin_id claim and
# derives the key that verifies commands the cloud sends back, so a node
# without it uploads but applies nothing.
#SYNC_UPLOAD_URL=http://127.0.0.1:8080
#SYNC_UPLOAD_KEY=replace-with-32-plus-random-characters
# Enqueue defaults to true for STORE/DC roles; override here.
#SYNC_ENQUEUE=true
SYNC_INTERVAL_SECONDS=5
SYNC_BATCH_LIMIT=100
SYNC_BREAKER_THRESHOLD=5
SYNC_BREAKER_BASE_COOLDOWN_SECONDS=30
SYNC_BREAKER_MAX_COOLDOWN_SECONDS=900
SYNC_RETENTION_DAYS=14
SYNC_DEGRADED_AFTER_SECONDS=900
RUST_LOG=inventory_backend=info

# ── Authentication ───────────────────────────────────────────────────────────
# Edge login is local and works offline. Cloud-projected users replace normal
# day-to-day bootstrap use once the first signed auth policy has synchronized.
# The bootstrap secret creates a node-local break-glass ADMIN only when the
# user table is empty; delete it from this file after the first sign-in.
INVENTORY_AUTH_MODE=required
#INVENTORY_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-node-unique-break-glass-secret
INVENTORY_AUTH_TOKEN_TTL_MINUTES=720
INVENTORY_AUTH_SESSION_IDLE_MINUTES=30
INVENTORY_AUTH_COOKIE_SECURE=false       # loopback HTTP only; true anywhere else

# Dev-only control surface (test clock), fail-closed.
#INVENTORY_ENABLE_TEST_CONTROLS=true
