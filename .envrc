# ~/Documents/itulah/.envrc — environment khusus project ini
# direnv memuat ini otomatis saat masuk folder, dan membongkarnya saat keluar.
# Jalankan sekali: direnv allow
export OMP_PROFILE="$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")"
export AGENT_BROWSER_ENGINE=lightpanda
export AGENT_BROWSER_SESSION="$(agent-browser session id --scope worktree --prefix "$OMP_PROFILE")"

# --- Android ---
export JAVA_HOME="/opt/homebrew/opt/openjdk@17"
export ANDROID_HOME="/opt/homebrew/share/android-commandlinetools"
export ANDROID_SDK_ROOT="$ANDROID_HOME"
PATH_add "$JAVA_HOME/bin"
PATH_add "$ANDROID_HOME/platform-tools"

# --- Postgres ---
PATH_add "/opt/homebrew/opt/postgresql@17/bin"

# --- Rust: batasi job agar tidak memicu swap di 8 GB ---
export CARGO_BUILD_JOBS=6

# --- Muat .env project (DATABASE_URL dll) kalau ada ---
if [ -f .env ]; then
  dotenv .env
fi
