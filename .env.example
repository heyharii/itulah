DATABASE_URL=postgres://inventory:inventory@localhost:5432/inventory
BIND_ADDR=127.0.0.1:8080
INVENTORY_NODE_ID=cloud-primary
INVENTORY_NODE_ROLE=CLOUD
RFID_BURST_WINDOW_SECONDS=10
OBSERVED_WINDOW_HOURS=24
LOST_RISK_WINDOW_DAYS=30
INVENTORY_ENABLE_TEST_CONTROLS=false
RUST_LOG=inventory_backend=info,tower_http=info

# Ordered edge->cloud sync (backend/migrations/postgres/0006_sync_outbox.sql).
# Identity: origin stream = (INVENTORY_NODE_ID, INVENTORY_ORIGIN_GENERATION).
INVENTORY_ORIGIN_GENERATION=1
# Enqueue defaults to true for STORE/DC roles, false for CLOUD; override here.
#SYNC_ENQUEUE=true
# Where this edge uploads its facts (the receiving node's base URL). Unset = sender off.
#SYNC_UPLOAD_URL=http://127.0.0.1:8081
#SYNC_UPLOAD_KEY=replace-with-32-plus-random-characters
# Cloud master key for origin provisioning and command administration. It is
# never accepted as an origin's ingest identity when authentication is enabled.
# Required (32+ random characters) when Cloud authentication is enabled.
SYNC_INGEST_KEY=change-this-to-at-least-32-random-characters
SYNC_INTERVAL_SECONDS=5
SYNC_BATCH_LIMIT=100
SYNC_BREAKER_THRESHOLD=5
SYNC_BREAKER_BASE_COOLDOWN_SECONDS=30
SYNC_BREAKER_MAX_COOLDOWN_SECONDS=900
SYNC_RETENTION_DAYS=14
SYNC_DEGRADED_AFTER_SECONDS=900
# Receiver applies ingested facts into its own ledger (default: true on CLOUD role).
#SYNC_APPLY=true

# Opaque, server-side authentication. Required is the secure default; use
# disabled only for isolated development tests. The first boot creates admin.
INVENTORY_AUTH_MODE=required
INVENTORY_BOOTSTRAP_ADMIN_PASSWORD=change-this-before-first-start
INVENTORY_AUTH_TOKEN_TTL_MINUTES=720
INVENTORY_AUTH_SESSION_IDLE_MINUTES=30
# true behind HTTPS; false is needed for the loopback HTTP development URL.
INVENTORY_AUTH_COOKIE_SECURE=false
# Comma-separated exact browser origins; unset = same-origin requests only.
#INVENTORY_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080
# Downstream lane (cloud -> store commands) rides the same upload cycle;
# commands are HMAC-signed under each store's ingest key, so SYNC_UPLOAD_KEY
# must be set for a store to accept them.

# --- Edge nodes (DC / Store, SQLite) ---
# Every edge always captures owner-scoped Pool snapshots in its SQLite outbox.
# SYNC_UPLOAD_URL only enables the sender; unset means the backlog stays local.
# When the URL is set, a nonempty SYNC_UPLOAD_KEY is required for upload and
# downstream command verification. For a generation rollover, first update
# the origin's active_generation in Cloud, then advance
# INVENTORY_ORIGIN_GENERATION only after the previous generation's backlog is
# fully acknowledged. A premature future-generation upload remains queued and
# retries after Cloud activation.
#SYNC_UPLOAD_URL=http://cloud:8080
#SYNC_UPLOAD_KEY=replace-with-32-plus-random-characters
INVENTORY_DATABASE_PATH=./store-edge.sqlite3
# Edge login is local and works offline. Cloud-projected users replace normal
# day-to-day bootstrap use once the first signed auth policy has synchronized.
INVENTORY_AUTH_MODE=required
#INVENTORY_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-node-unique-break-glass-secret
INVENTORY_AUTH_TOKEN_TTL_MINUTES=720
INVENTORY_AUTH_SESSION_IDLE_MINUTES=30
INVENTORY_AUTH_COOKIE_SECURE=false
