DATABASE_URL=postgres://inventory:inventory@localhost:5432/inventory
BIND_ADDR=127.0.0.1:8080
INVENTORY_NODE_ID=cloud-primary
INVENTORY_NODE_ROLE=CLOUD
RFID_BURST_WINDOW_SECONDS=10
OBSERVED_WINDOW_HOURS=24
LOST_RISK_WINDOW_DAYS=30
INVENTORY_ENABLE_TEST_CONTROLS=false

# ── Virtual business clock (VIRTUAL-TIME-PLAN.md) ────────────────────────────
# Business time follows the wall clock unless you turn one of these on. Only
# for disposable demo/test environments: INVENTORY_ENABLE_TEST_CONTROLS=true
# is required for the control endpoint either way.
#
#   ITULAH_CLOCK=system          (default) wall clock, zero behaviour change
#   ITULAH_CLOCK=controlled      frozen at ITULAH_CLOCK_AT (RFC 3339);
#                                moved by hand — the Stripe test-clock shape
#   ITULAH_CLOCK=scaled          linear compression: one year through ten wall
#                                hours is anchor_virtual=2026-01-01T00:00:00+07:00,
#                                anchor_real=<boot time>, factor=876
# Example — run the year 2026 in ten hours:
#   ITULAH_CLOCK=scaled
#   ITULAH_CLOCK_ANCHOR_VIRTUAL=2026-01-01T00:00:00+07:00
#   ITULAH_CLOCK_ANCHOR_REAL=2026-09-22T09:00:00+07:00
#   ITULAH_CLOCK_FACTOR=876
ITULAH_CLOCK=system
RUST_LOG=inventory_backend=info,tower_http=info

# Ordered edge->cloud sync (backend/migrations/postgres/0006_sync_outbox.sql).
# Identity: origin stream = (INVENTORY_NODE_ID, INVENTORY_ORIGIN_GENERATION).
INVENTORY_ORIGIN_GENERATION=1
# Enqueue defaults to true for STORE/DC roles, false for CLOUD; override here.
#SYNC_ENQUEUE=true
# Where this edge uploads its facts (the receiving node's base URL). Unset = sender off.
#SYNC_UPLOAD_URL=http://127.0.0.1:8081
#SYNC_UPLOAD_KEY=replace-with-32-plus-random-characters
# Cloud master key for origin provisioning and command administration. It is
# never accepted as an origin's ingest identity when authentication is enabled.
# Required (32+ random characters) when Cloud authentication is enabled.
SYNC_INGEST_KEY=change-this-to-at-least-32-random-characters
SYNC_INTERVAL_SECONDS=5
SYNC_BATCH_LIMIT=100
SYNC_BREAKER_THRESHOLD=5
SYNC_BREAKER_BASE_COOLDOWN_SECONDS=30
SYNC_BREAKER_MAX_COOLDOWN_SECONDS=900
SYNC_RETENTION_DAYS=14
SYNC_DEGRADED_AFTER_SECONDS=900
# Receiver applies ingested facts into its own ledger (default: true on CLOUD role).
#SYNC_APPLY=true

# Opaque, server-side authentication. Required is the secure default; use
# disabled only for isolated development tests. The first boot creates admin.
INVENTORY_AUTH_MODE=required
INVENTORY_BOOTSTRAP_ADMIN_PASSWORD=change-this-before-first-start
INVENTORY_AUTH_TOKEN_TTL_MINUTES=720
INVENTORY_AUTH_SESSION_IDLE_MINUTES=30
# true behind HTTPS; false is needed for the loopback HTTP development URL.
INVENTORY_AUTH_COOKIE_SECURE=false
# Month-end Finance agents (depreciation, OE replacement reserve, prepaid
# spreading, amortisation) run by default (owner decision 25 Sep). Set false
# only to stop unattended month-end posting on this node; the Finance close
# readiness screen shows which way this switch is set.
INVENTORY_FINANCE_AUTOMATION_ENABLED=true
# Comma-separated exact browser origins; unset = same-origin requests only.
#INVENTORY_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080
# Downstream lane (cloud -> store commands) rides the same upload cycle;
# commands are HMAC-signed under each store's ingest key, so SYNC_UPLOAD_KEY
# must be set for a store to accept them.

# --- Edge nodes (DC / Store, SQLite) ---
# Every edge always captures owner-scoped Pool snapshots in its SQLite outbox.
# SYNC_UPLOAD_URL only enables the sender; unset means the backlog stays local.
# When the URL is set, a nonempty SYNC_UPLOAD_KEY is required for upload and
# downstream command verification. For a generation rollover, first update
# the origin's active_generation in Cloud, then advance
# INVENTORY_ORIGIN_GENERATION only after the previous generation's backlog is
# fully acknowledged. A premature future-generation upload remains queued and
# retries after Cloud activation.
#SYNC_UPLOAD_URL=http://cloud:8080
#SYNC_UPLOAD_KEY=replace-with-32-plus-random-characters
INVENTORY_DATABASE_PATH=./store-edge.sqlite3
# Edge login is local and works offline. Cloud-projected users replace normal
# day-to-day bootstrap use once the first signed auth policy has synchronized.
INVENTORY_AUTH_MODE=required
#INVENTORY_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-node-unique-break-glass-secret
INVENTORY_AUTH_TOKEN_TTL_MINUTES=720
INVENTORY_AUTH_SESSION_IDLE_MINUTES=30
INVENTORY_AUTH_COOKIE_SECURE=false

# Catalogue imagery in object storage (Cloudflare R2). Leave unset and the
# node simply serves no images — /api/v1/catalogue/images answers 404 rather
# than failing to boot. R2_PUBLIC_BASE_URL is the browser-facing domain and is
# NOT the S3 endpoint; without it every handed-out URL is presigned and expires.
R2_ACCOUNT_ID=
R2_BUCKET=images
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
R2_CATALOGUE_PREFIX=catalogue
# Imagery still filed under a supplier's own numbering, awaiting a link to one
# of our article codes. A supplier code never appears in the catalogue prefix.
R2_SUPPLIER_PREFIX=supplier

# Attachments on conversations and discussions. A SEPARATE bucket from the one
# above, and this is not tidiness: R2_BUCKET is served through a public base
# URL so a till can fetch a photograph unsigned, and an attachment written
# there is readable by anyone holding its file id, permanently, with no
# session. There is deliberately no public base URL for this bucket and no
# code path that produces one — attachments are read back through the node,
# behind the participant check.
#
# Leave it unset and attachments are stored in Postgres instead. They are
# never written to R2_BUCKET as a fallback.
R2_ATTACHMENT_BUCKET=files
# Optional: a token scoped to the attachment bucket alone, so a key that can
# read catalogue imagery cannot read anybody's correspondence. Falls back to
# the catalogue credentials above.
R2_ATTACHMENT_ACCESS_KEY_ID=
R2_ATTACHMENT_SECRET_ACCESS_KEY=

# The assistant in the hub (cloud/http/assistant.rs). Unset is a valid
# deployment: every screen works as before and the panel says the node has no
# key rather than failing on the first question. Set it and the panel answers
# questions using this node's own reads as its tools — reads only. Who may ask
# is a permission (POST /api/v1/assistant/ask, Admin since migration 0500). A
# supervisor's reads are cut to the site they are posted to; the ledger,
# reports and SQL are offered to Admins only.
#
# The key is read by the server and never leaves it. The browser talks to this
# node; this node talks to OpenRouter. Every request is routed only to hosts
# that support every parameter it sends (tools, reasoning) and that retain
# nothing (zero data retention).
#
# What each answer cost is kept, and the month's total is capped by the
# finance setting "Assistant monthly budget" (assistant_monthly_budget_usd,
# US$10 unless Finance changes it in Accounts settings).
OPENROUTER_API_KEY=
# Which model answers, in OpenRouter's naming. Defaulted in code to Gemma 4
# 31B so an operator does not have to know a model id to start the server.
# A replacement must call tools, reason, and have zero-data-retention hosts on
# OpenRouter, or every question fails with "no endpoints": the smaller
# google/gemma-4-26b-a4b-it qualifies.
#ASSISTANT_MODEL=google/gemma-4-31b-it
# The gateway itself, for a deployment that proxies it.
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
