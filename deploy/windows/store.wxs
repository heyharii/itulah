<!--
  Central Store Server — Windows installer (WiX v5).

  Built by .github/workflows/store-server.yml:

    wix build store.wxs -arch x64 -ext WixToolset.Util.wixext -ext WixToolset.UI.wixext
              -d Version=1.2.3 -d BinDir=<dir with store.exe and web\>
              -d TrayScript=store-tray.ps1
              [-d CloudUrl=https://… (the build's ITULAH_DEFAULT_CLOUD_URL)]
              -o central-store-server-1.2.3-x64.msi

  Interactive:   double-click. It installs and starts the service, then opens
                 the installer window (the setup page as an Edge app window):
                 check this PC, the install code from Central › Stores › the
                 store › Server, installing, Ready.
  Silent:        msiexec /i central-store-server-1.2.3-x64.msi /qn ENROLL_CODE=7K4P9-QX2MA
                 CLOUD_URL is optional: it defaults to the Central address the
                 build was made with (also baked into store.exe itself).

  Everything the installer does to the machine is done by the program itself
  (`store.exe install-service`, `stage-code`, `uninstall-service`) so that a
  person with an elevated prompt can do exactly the same by hand, and so the
  behaviour is tested once rather than once in Rust and once in XML.

  Upgrades replace the program and keep %ProgramData%\itulah\store — the
  database, the enrolment, the logs — untouched. Uninstall waits for head
  office: a connected server goes only once head office chose Prepare for
  removal (a release good for 24 hours) and nothing is unsent, no drawer open
  and no basket held — checked again at that moment (`edge/removal.rs`). The
  data then goes with the program. FORCE_UNINSTALL=1, for a PC that can no
  longer reach head office, skips the checks; whatever is unsent is first
  copied to %ProgramData%\itulah\backups, administrators only.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Central Store Server"
           Manufacturer="itulah"
           Version="$(Version)"
           UpgradeCode="6f0b5c8e-2d4a-4c7e-9b1f-3a5e7d9c1b24"
           Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer Central Store Server is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ENROLL_CODE" Secure="yes" Hidden="yes" />
    <Property Id="FORCE_UNINSTALL" Secure="yes" />
    <!-- Restart Manager stays on: with it disabled (MSIRESTARTMANAGERCONTROL)
         Windows Installer's own files-in-use check loops on InstallValidate
         for the running service (riza-1, 30 Oct 2026). An upgrade therefore
         asks once, "Close the applications", already chosen. -->
    <!-- Central's address, from the build (-d CloudUrl=…), so nobody types it.
         `msiexec … CLOUD_URL=…` still overrides it. -->
    <?ifndef CloudUrl?>
    <?define CloudUrl=""?>
    <?endif?>
    <?if "$(CloudUrl)" = ""?>
    <Property Id="CLOUD_URL" Secure="yes" />
    <?else?>
    <Property Id="CLOUD_URL" Value="$(CloudUrl)" Secure="yes" />
    <?endif?>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="itulah Store">
        <Component Id="Program" Bitness="always64">
          <File Id="StoreExe" Source="$(BinDir)\store.exe" KeyPath="yes" />
        </Component>
        <!-- The dot by the clock (store-tray.ps1): the service has no window,
             so this is how the person at the till sees whether it is well.
             Started at every sign-in for every account on the PC. -->
        <Component Id="Tray" Bitness="always64">
          <File Id="TrayScript" Source="$(TrayScript)" Name="store-tray.ps1" KeyPath="yes" />
          <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run"
                         Name="itulah Store tray" Type="string"
                         Value="powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -File &quot;[#TrayScript]&quot;" />
        </Component>
        <!-- central-store: links, which the setup page's buttons open: they
             run `store.exe prepare-pc` after Windows' administrator question
             (edge/laptop.rs). -->
        <Component Id="Protocol" Bitness="always64">
          <RegistryKey Root="HKLM" Key="Software\Classes\central-store">
            <RegistryValue Type="string" Value="URL:Central Store Server" KeyPath="yes" />
            <RegistryValue Name="URL Protocol" Type="string" Value="" />
            <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[#StoreExe]&quot; open-link &quot;%1&quot;" />
          </RegistryKey>
        </Component>
        <Directory Id="WebFolder" Name="web" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="MenuFolder" Name="itulah Store">
        <Component Id="MenuShortcuts" Guid="0c9f2a61-5b7e-4f3d-8a2c-1e6d4b9f7a35">
          <util:InternetShortcut Id="SetupShortcut"
                                 Name="Central Store Server — Setup and status"
                                 Target="http://127.0.0.1:8082/setup" />
          <RemoveFolder Id="RemoveMenuFolder" On="uninstall" />
          <RegistryValue Root="HKLM" Key="Software\itulah\Store" Name="menu"
                         Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentRef Id="Program" />
      <ComponentRef Id="Tray" />
      <ComponentRef Id="Protocol" />
      <!-- The shop's web apps the node serves; harvested at build time. -->
      <Files Directory="WebFolder" Include="$(BinDir)\web\**" />
      <ComponentRef Id="MenuShortcuts" />
    </Feature>

    <!-- Deferred and not impersonated: these run as SYSTEM, which is what
         registering a service and restricting ProgramData need. -->
    <CustomAction Id="StageCode" FileRef="StoreExe"
                  ExeCommand="stage-code &quot;[ENROLL_CODE]&quot; &quot;[CLOUD_URL]&quot;"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="InstallService" FileRef="StoreExe"
                  ExeCommand="install-service"
                  Execute="deferred" Impersonate="no" Return="check" />
    <!-- What broke at C015 on 28 Oct, fixed while the installer has an
         administrator's rights: the shop's network Private (the firewall
         rule opens Private networks only) and no sleep on mains. -->
    <CustomAction Id="PreparePc" FileRef="StoreExe"
                  ExeCommand="prepare-pc"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <!-- Removing the product asks `store.exe can-uninstall` first (as SYSTEM,
         which may read the data folder) and stops there, nothing changed,
         unless head office released the server and nothing would be lost.
         With people at the PC it shows why in a window. `wipe-data` then
         removes the data once the service is stopped, copying the database
         to %ProgramData%\itulah\backups first when anything is still unsent
         (a sale in the seconds before the stop, or a forced removal).
         Upgrades skip all of it: the data stays for the new version. -->
    <CustomAction Id="CheckUnsentUI" FileRef="StoreExe"
                  ExeCommand="can-uninstall --ui"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="CheckUnsentQuiet" FileRef="StoreExe"
                  ExeCommand="can-uninstall"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="WipeData" FileRef="StoreExe"
                  ExeCommand="wipe-data"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="UninstallService" FileRef="StoreExe"
                  ExeCommand="uninstall-service"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <!-- Show the tray icon now rather than at the next sign-in. -->
    <CustomAction Id="StartTray" Directory="INSTALLFOLDER"
                  ExeCommand="powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -File &quot;[#TrayScript]&quot;"
                  Execute="immediate" Impersonate="yes" Return="asyncNoWait" />
    <!-- After an interactive install, the installer window itself: the setup
         page (edge/enrolment_setup.html) as an Edge app window, no address
         bar — check this PC, the install code, installing, Ready. On an
         upgrade it opens on Ready. 127.0.0.1, not localhost: setup listens
         on IPv4 loopback only. -->
    <CustomAction Id="OpenSetup" Directory="INSTALLFOLDER"
                  ExeCommand="powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -Command &quot;try { Start-Process msedge -ArgumentList '--app=http://127.0.0.1:8082/setup','--window-size=960,680' -ErrorAction Stop } catch { Start-Process 'http://127.0.0.1:8082/setup' }&quot;"
                  Execute="immediate" Impersonate="yes" Return="asyncNoWait" />

    <!-- No dialog of its own: double-click, Windows asks for administrator
         rights, a progress bar, then the installer window above — no
         "Completed" page of WiX's own: Ready is the finish. The code
         is asked there, after the PC is checked. Silent installs still take
         ENROLL_CODE on the command line. -->
    <UI Id="CentralStoreUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Segoe UI" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Segoe UI" Size="9" Bold="yes" />

      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="WixUI_Mode" Value="Minimal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

    </UI>
    <UIRef Id="WixUI_Common" />

    <InstallExecuteSequence>
      <Custom Action="CheckUnsentUI" Before="UninstallService"
              Condition="Installed AND REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND NOT FORCE_UNINSTALL AND UILevel &gt; 2" />
      <Custom Action="CheckUnsentQuiet" After="CheckUnsentUI"
              Condition="Installed AND REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND NOT FORCE_UNINSTALL AND UILevel &lt;= 2" />
      <Custom Action="UninstallService" Before="RemoveFiles"
              Condition="Installed AND REMOVE=&quot;ALL&quot;" />
      <Custom Action="WipeData" After="UninstallService"
              Condition="Installed AND REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="StageCode" After="InstallFiles"
              Condition="NOT REMOVE AND ENROLL_CODE" />
      <Custom Action="InstallService" After="StageCode"
              Condition="NOT REMOVE" />
      <Custom Action="PreparePc" After="InstallService"
              Condition="NOT REMOVE" />
      <Custom Action="StartTray" After="InstallFinalize"
              Condition="NOT REMOVE AND UILevel &gt;= 4" />
      <Custom Action="OpenSetup" After="StartTray"
              Condition="NOT REMOVE AND UILevel &gt;= 4" />
    </InstallExecuteSequence>
  </Package>
</Wix>
