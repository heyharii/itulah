# One shop's configuration. `provision-store.sh` prints this filled in.

# Identity. INVENTORY_NODE_ID is also the sync origin: the cloud knows this
# shop's facts by this name, so it must be unique and must not change. A
# generation bump is how you deliberately restart a shop's sequence after a
# rebuild — activate that generation in Cloud first, then change it here only
# after the previous generation is fully acknowledged.
INVENTORY_NODE_ID=store-07
INVENTORY_SITE_ID=store-07
INVENTORY_ORIGIN_GENERATION=1

INVENTORY_DATABASE_PATH=/var/lib/itulah/store-edge.sqlite3
BIND_ADDR=127.0.0.1:8082

# Human sessions and RFID verification are local/offline. This secret creates
# a node-local break-glass ADMIN only when the user table is empty.
INVENTORY_AUTH_MODE=required
INVENTORY_BOOTSTRAP_ADMIN_PASSWORD=replace-me-node-unique
INVENTORY_AUTH_TOKEN_TTL_MINUTES=720
INVENTORY_AUTH_SESSION_IDLE_MINUTES=30
INVENTORY_AUTH_COOKIE_SECURE=false

# The cloud base URL, addressed by its tailnet name. Do not append
# /api/v1/sync/ingest; the sender adds that path. No IP, no certificate, no
# public DNS: this name only resolves inside the fleet's own network.
SYNC_UPLOAD_URL=http://cloud.itulah.internal:8080

# This shop's own key. It authorises the `origin_id` claim in every upload —
# the tailnet proves WHICH MACHINE is calling, this proves WHICH SHOP it may
# speak for. It also derives the key that verifies commands the cloud sends
# back, so a shop without it uploads but applies nothing.
SYNC_UPLOAD_KEY=replace-with-32-plus-random-characters

SYNC_INTERVAL_SECONDS=5
SYNC_BATCH_LIMIT=100
SYNC_RETENTION_DAYS=14
RUST_LOG=inventory_backend=info
