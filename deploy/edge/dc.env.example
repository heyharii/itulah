# Distribution-centre Edge configuration.
# Copy to /etc/itulah/dc.env and replace every placeholder before starting.

INVENTORY_NODE_ID=dc-01
INVENTORY_SITE_ID=dc-01
INVENTORY_ORIGIN_GENERATION=1
INVENTORY_DATABASE_PATH=/var/lib/itulah/dc-edge.sqlite3
BIND_ADDR=127.0.0.1:8081

INVENTORY_AUTH_MODE=required
INVENTORY_BOOTSTRAP_ADMIN_PASSWORD=replace-me-node-unique
INVENTORY_AUTH_TOKEN_TTL_MINUTES=720
INVENTORY_AUTH_SESSION_IDLE_MINUTES=30
INVENTORY_AUTH_COOKIE_SECURE=false

# Set the Cloud base URL (public, or its tailnet-internal name) and this DC's
# own key. The Cloud provisions the matching origin binding before this is
# enabled.
SYNC_UPLOAD_URL=https://YOUR-CLOUD-HOST
SYNC_UPLOAD_KEY=replace-with-32-plus-random-characters
SYNC_INTERVAL_SECONDS=5
SYNC_BATCH_LIMIT=100
SYNC_BREAKER_THRESHOLD=5
SYNC_BREAKER_BASE_COOLDOWN_SECONDS=30
SYNC_BREAKER_MAX_COOLDOWN_SECONDS=900
SYNC_RETENTION_DAYS=14
RUST_LOG=inventory_backend=info
