# The DC edge running on a laptop, against the Cloud already deployed on
# Render. Copy to demo/dc/.env and replace the secrets there.
#
# RUN IT FROM ITS OWN DIRECTORY, not from the repository root. dotenvy searches
# upward from the working directory, and the root .env belongs to the CLOUD dev
# node (local Postgres, port 8080). A DC started from the root inherits it
# silently, which looks like the wrong database rather than the wrong config.
#
#     cd demo/dc && ../../backend/target/debug/dc
#
# See DEMO-RFID-BRIEF.md for the whole sequence, including the Render side.

INVENTORY_NODE_ID=dc-01
INVENTORY_SITE_ID=dc-01
INVENTORY_NODE_ROLE=DC

# TWO STEPS, and not in the other order.
#
# A fresh SQLite is born at generation 1 and immediately enqueues one bootstrap
# fact. The node refuses to advance to generation 2 while that fact is
# unacknowledged, and the refusal is right: a rollover that outruns an ack
# swallows facts that never arrived.
#
#   1. Leave this at 1, fill in the sync pair below, start the node, and let a
#      cycle pass. Cloud skips the bootstrap fact as a duplicate — its seq is
#      already below the dc-01 watermark — and acknowledges it.
#   2. Register generation 2 at the Cloud, then stop the node, set this to 2,
#      and start it again.
#
# After step 2 this node's sequence numbers live in their own epoch and cannot
# collide with anything the Render `dc` service ever uploaded.
INVENTORY_ORIGIN_GENERATION=1

INVENTORY_DATABASE_PATH=./dc-edge.sqlite3
BIND_ADDR=127.0.0.1:8092
# An api-only node: the browser surface is served by Vite in development.
FRONTEND_DIR=./web

INVENTORY_AUTH_MODE=required
INVENTORY_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-node-unique-secret
# false because the development URL is loopback HTTP; true behind HTTPS.
INVENTORY_AUTH_COOKIE_SECURE=false
INVENTORY_AUTH_TOKEN_TTL_MINUTES=720
# A demo runs longer than a shift's idle timeout, and being signed out mid-run
# is not the thing anybody came to watch.
INVENTORY_AUTH_SESSION_IDLE_MINUTES=480

# The Cloud that stays on Render, and dc-01's own ingest key — the value of
# SYNC_UPLOAD_KEY on the `dc` service in the Render dashboard. Pass that same
# key when registering generation 2: minting a new one would lock that service
# out permanently, and suspending it is meant to be reversible.
#
# While these are unset the node captures facts locally and only the sender is
# off. Labels still print; tagging jobs never arrive, because they ride the
# reply to this node's own upload.
#SYNC_UPLOAD_URL=https://itulah-cloud.onrender.com
#SYNC_UPLOAD_KEY=replace-with-the-key-issued-for-dc-01
SYNC_INTERVAL_SECONDS=5
SYNC_BATCH_LIMIT=100

RUST_LOG=inventory_backend=info
