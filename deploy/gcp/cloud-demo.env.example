# Copy to deploy/gcp/cloud-demo.env (git-ignored). deploy-demo.sh generates it
# if it is missing, with random secrets. Shared by all three demo nodes.
SYNC_INGEST_KEY=            # 32+ chars, fleet master the dc/store nodes authenticate with
INVENTORY_BOOTSTRAP_ADMIN_PASSWORD=Password01   # demo login `admin`
PG_PASSWORD=                # Postgres on the VM, never exposed outside the host
INVENTORY_SSO_SIGNING_KEY_HEX=   # 64 hex chars, stable across restarts
