# Copy to deploy/gcp/cloud.env (git-ignored) and fill in. deploy.sh stores the
# whole file in Secret Manager as `itulah-cloud-env`; the VM reads it at boot.
# DATABASE_URL is written by deploy.sh — do not set it here.
#
# The variables the cloud node carries. deploy.sh appends DATABASE_URL itself.

INVENTORY_NODE_ID=cloud-primary
INVENTORY_NODE_ROLE=CLOUD
INVENTORY_ORIGIN_GENERATION=1
INVENTORY_AUTH_MODE=required
INVENTORY_AUTH_COOKIE_SECURE=true
SYNC_APPLY=true
SYNC_ENQUEUE=false
INVENTORY_ENABLE_TEST_CONTROLS=false
RUST_LOG=inventory_backend=info,tower_http=info
FRONTEND_DIR=/app/api-only

# SYNC_INGEST_KEY is the fleet master the store nodes authenticate with. On a
# fresh fleet choose a new 32+ character value and reuse it when provisioning
# stores.
SYNC_INGEST_KEY=
INVENTORY_BOOTSTRAP_ADMIN_PASSWORD=

# Catalogue imagery and attachments (Cloudflare R2).
R2_ACCOUNT_ID=0aded8001fcbfddf2dfd44f8527ac63e
R2_BUCKET=images
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://pub-d53f40cbe4a54e02af563bbef8b0df05.r2.dev
R2_CATALOGUE_PREFIX=catalogue
R2_SUPPLIER_PREFIX=supplier
R2_ATTACHMENT_BUCKET=files
R2_ATTACHMENT_ACCESS_KEY_ID=
R2_ATTACHMENT_SECRET_ACCESS_KEY=

# Optional: the hub assistant.
OPENROUTER_API_KEY=
