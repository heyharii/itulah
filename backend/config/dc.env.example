INVENTORY_SITE_ID=dc-01
INVENTORY_NODE_ID=dc-01-edge
INVENTORY_DATABASE_PATH=./dc-edge.sqlite3
INVENTORY_ORIGIN_GENERATION=1
BIND_ADDR=127.0.0.1:8081
RUST_LOG=info

INVENTORY_AUTH_MODE=required
INVENTORY_BOOTSTRAP_ADMIN_PASSWORD=replace-with-dc-unique-break-glass-password
INVENTORY_AUTH_TOKEN_TTL_MINUTES=720
INVENTORY_AUTH_SESSION_IDLE_MINUTES=30
INVENTORY_AUTH_COOKIE_SECURE=false

# Pool snapshots are always captured durably. Set both values to enable the
# optional HTTP sender; leave both unset to retain the backlog locally.
# SYNC_UPLOAD_URL is the Cloud base URL (do not append /api/v1/sync/ingest).
# For rollover, activate the new generation in Cloud before changing
# INVENTORY_ORIGIN_GENERATION here.
#SYNC_UPLOAD_URL=http://127.0.0.1:8080
#SYNC_UPLOAD_KEY=replace-with-32-plus-random-characters
SYNC_INTERVAL_SECONDS=5
SYNC_BATCH_LIMIT=100
SYNC_BREAKER_THRESHOLD=5
SYNC_BREAKER_BASE_COOLDOWN_SECONDS=30
SYNC_BREAKER_MAX_COOLDOWN_SECONDS=900
SYNC_RETENTION_DAYS=14
