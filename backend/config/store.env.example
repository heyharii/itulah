INVENTORY_SITE_ID=store-07
INVENTORY_NODE_ID=store-07-edge
INVENTORY_DATABASE_PATH=./store-edge.sqlite3
INVENTORY_ORIGIN_GENERATION=1
BIND_ADDR=127.0.0.1:8082
RUST_LOG=info

# Local opaque sessions remain available while Cloud is unreachable. Set a
# node-unique bootstrap password on first install; normal users and RFID
# device scopes arrive in signed Cloud policy commands.
INVENTORY_AUTH_MODE=required
INVENTORY_BOOTSTRAP_ADMIN_PASSWORD=replace-with-store-unique-break-glass-password
INVENTORY_AUTH_TOKEN_TTL_MINUTES=720
INVENTORY_AUTH_SESSION_IDLE_MINUTES=30
INVENTORY_AUTH_COOKIE_SECURE=false

# Pool snapshots are always captured durably. Set both values to enable the
# optional HTTP sender and downstream commands; leave both unset to retain
# the backlog locally. SYNC_UPLOAD_URL is the Cloud base URL (do not append
# /api/v1/sync/ingest). For rollover, activate the new generation in Cloud
# before changing INVENTORY_ORIGIN_GENERATION here.
#SYNC_UPLOAD_URL=http://127.0.0.1:8080
#SYNC_UPLOAD_KEY=replace-with-32-plus-random-characters
SYNC_INTERVAL_SECONDS=5
SYNC_BATCH_LIMIT=100
SYNC_BREAKER_THRESHOLD=5
SYNC_BREAKER_BASE_COOLDOWN_SECONDS=30
SYNC_BREAKER_MAX_COOLDOWN_SECONDS=900
SYNC_RETENTION_DAYS=14
