{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@itulah/contract": ["../frontend-contract/src/index.ts"],
      "@itulah/contract/client": ["../frontend-contract/src/client/index.ts"],
      "@itulah/contract/money": ["../frontend-contract/src/money/index.ts"],
      "@itulah/contract/reporting": ["../frontend-contract/src/reporting/index.ts"]
    }
  },
  "include": ["src", "../frontend-contract/src"]
}
